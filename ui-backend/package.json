{
  "name": "z-cc-orchestrator-ui-backend",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS-бэкенд веб-панели для ai-task. Запускает раннер как subprocess и читает .orchestrator/state.json.",
  "scripts": {
    "build": "tsc",
    "dev": "tsc-watch --onSuccess \"node dist/main.js\"",
    "start:dev": "tsc-watch --onSuccess \"node dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "tsc-watch": "^6.2.0",
    "typescript": "^5.6.0"
  }
}
