{
  "name": "z-cc-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Оркестрация трёх AI-CLI (Claude, Codex, GLM) единым Node/TS-раннером.",
  "bin": {
    "ai-task": "bin/ai-task.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "ai-task": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "ui:backend": "cd ui-backend && npm run start:dev",
    "ui:web": "cd ui-web && npm run dev",
    "ui:health": "node scripts/ui-health.mjs",
    "ui:open": "node scripts/open-browser.mjs",
    "ui": "concurrently -n backend,web -c blue,green \"npm:ui:backend\" \"npm:ui:web\"",
    "ui:full": "concurrently -n backend,web,open -c blue,green,yellow \"npm:ui:backend\" \"npm:ui:web\" \"npm:ui:open\""
  },
  "dependencies": {
    "async-mutex": "^0.5.0",
    "dotenv": "^16.4.5",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "concurrently": "^8.2.2",
    "tsx": "^4.23.0",
    "typescript": "^5.6.0"
  }
}
